# Device Configuration
-a "iCE40UP"
-p iCE40UP5K
-t SG48
-sp "High-Performance_1.2V"

# Synthesis Strategy Options
-frequency 200
-optimization_goal Area
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-max_fanout 1000
-fsm_encoding_style Auto
-fix_gated_clocks 1
-loop_limit 1950
-use_io_reg auto
-drc_cfg 35103300 20
-use_io_insertion 1
-resolve_mixed_drivers 0

# Constraint Files
-sdc "lab2_ai_proto2_implement_cpe.ldc"

# Search Paths
-path "C:/lscc/radiant/2026.1/ispfpga/ice40tp/data"
-path "."
-path ".."
-path "../source/implement"
-path "../../../../e155-lab1/fpga/iCE40_lab1/source/impl_1"

# PMI Library Files
-ver "C:/lscc/radiant/2026.1/ip/pmi/pmi_iCE40UP.v"
-lib pmi -vhd "C:/lscc/radiant/2026.1/ip/pmi/pmi_iCE40UP.vhd"

# Source Files
-sver "../source/implement/lab2_ai_proto2.sv"
-sver "../../../../e155-lab1/fpga/iCE40_lab1/source/impl_1/counter_2_4Hz.sv"
-sver "../../../../e155-lab1/fpga/iCE40_lab1/source/impl_1/switch_to_display.sv"
-path ".."
-top lab2_ai_proto2
# Output Configuration
-udb "lab2_ai_proto2_implement_rtl.udb"
-output_hdl "lab2_ai_proto2_implement.vm"
